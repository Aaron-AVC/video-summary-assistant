{
  "name": "video-summary-assistant",
  "displayName": "Video Summary Assistant",
  "version": "2026.8.22",
  "private": true,
  "description": "Local-first Chromium extension that turns captioned YouTube and Bilibili videos into structured, jumpable summaries using any OpenAI-compatible API.",
  "homepage": "https://github.com/Aaron-AVC/video-summary-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-AVC/video-summary-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/Aaron-AVC/video-summary-assistant/issues"
  },
  "keywords": [
    "youtube",
    "summarizer",
    "chrome-extension",
    "browser-extension",
    "plasmo",
    "openai",
    "openai-compatible",
    "llm",
    "transcript",
    "captions",
    "local-first",
    "sidepanel",
    "react",
    "shadcn-ui"
  ],
  "packageManager": "bun@1.2.5",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:artifact": "bun scripts/verify-build-artifact.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/chrome": "^0.1.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "plasmo": "^0.90.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react-remove-scroll-bar": "2.3.7"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "storage",
      "tabs",
      "scripting"
    ],
    "host_permissions": [
      "https://www.youtube.com/*",
      "https://youtube.com/*",
      "https://www.bilibili.com/*",
      "https://api.bilibili.com/*",
      "https://*.hdslb.com/*"
    ],
    "optional_host_permissions": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "http://[::1]/*"
    ]
  }
}
